generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique // "Marketing", "Psychology", "Computer Science"...
  slug    String   @unique
  color   String   @default("lavender") // lavender | sunshine | coral | ink — card badge color
  courses Course[]
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  title     String? // "Senior UX Designer, ex-Google"
  bio       String?  @db.Text
  avatarUrl String?
  certified Boolean  @default(true)
  courses   Course[]
}

model Course {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  summary      String
  description  String     @db.Text
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  teacherId    String
  teacher      Teacher    @relation(fields: [teacherId], references: [id])
  level        String     // "Beginner" | "Intermediate" | "Advanced"
  durationHrs  Int
  price        Int        // in rupees; 0 = free
  isNew        Boolean    @default(false)
  isRecommended Boolean   @default(false)
  enrolledCount Int       @default(0)
  rating       Float      @default(4.8)
  createdAt    DateTime   @default(now())
  reviews      Review[]
  enrollments  Enrollment[]
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String?
  createdAt    DateTime      @default(now())
  accounts     Account[]
  sessions     Session[]
  enrollments  Enrollment[]
  reviews      Review[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  progress  Int      @default(0) // percent 0-100
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
